TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
OPENAI_API_KEY=
BRIDGE_SECRET=change-me-to-random-string
BRIDGE_WS_PORT=8765

# ── Игровой контур (привязка аккаунта + уведомления о ивентах) ──
# Бэкенд сайта (go-play-be), куда бот шлёт код привязки. Без него /link отвечает "недоступно".
WEBSITE_API_URL=
WEBSITE_API_TOKEN=
# Секрет для POST /notify (рассылка ивентов подписчикам). Без него /notify выключен.
NOTIFY_SECRET=
# Файл со списком подписчиков на уведомления.
# В Docker образ ставит /data/subscribers.json. Чтобы список пережил редеплой,
# нужен постоянный диск на /data: на Railway — Volume с mount path /data
# (VOLUME в Dockerfile там запрещён), локально — `-v goplay-tg-subs:/data`.
SUBSCRIBERS_FILE=subscribers.json
