# ── Telegram ──
TELEGRAM_BOT_TOKEN=

# ── Мост до игровых серверов ──
# Этим же секретом авторизуется go-play-be (роль "api"), через который сайт
# выдаёт донат. Менять только вместе с конфигами плагинов и бэкендом сайта:
#   velocity/plugins/goplaybridge/config.yml
#   <режим>/plugins/GoPlayBridgeBackend/config.yml
BRIDGE_SECRET=change-me-to-random-string
# На Railway порт приходит в PORT и он важнее этого значения.
BRIDGE_WS_PORT=8765

# ── Рассылка анонсов ──
# Секрет для POST /notify. Без него эндпоинт выключен.
NOTIFY_SECRET=

# ── Хранилище ──
# Привязки аккаунтов, подписки на темы, журнал отправленных пушей.
# В Docker образ подставляет /data/goplay.db; чтобы данные пережили редеплой,
# на Railway нужен Volume с mount path /data.
DATABASE_FILE=goplay.db
